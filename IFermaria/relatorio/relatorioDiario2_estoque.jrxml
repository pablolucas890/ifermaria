<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="relatorioDiario2_estoque" language="groovy" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="5dedeae6-18fe-469d-bda8-df7e533cda64">
	<property name="ireport.zoom" value="1.6500000000000024"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="idAtendimento" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT
     medicamento.`nome` AS medicamento_nome,
     medicamento.`tipo` AS medicamento_tipo,
     estoque.`dataValidade` AS estoque_dataValidade,
     atendimento_estoque.`atendimentos_idAtendimanto` AS atendimento_estoque_atendimentos_idAtendimanto,
     atendimento_estoque.`estoque_idestoque` AS atendimento_estoque_estoque_idestoque,
     estoque.`quantAntiga` AS estoque_quantAntiga,
     estoque.`quant_atual` AS estoque_quant_atual,
     estoque.`lote` AS lote
FROM
     `medicamento` medicamento INNER JOIN `estoque` estoque ON medicamento.`idmedicamento` = estoque.`medicamento_idmedicamento`
     INNER JOIN `atendimento_estoque` atendimento_estoque ON estoque.`idestoque` = atendimento_estoque.`estoque_idestoque`
WHERE
     atendimentos_idAtendimanto = $P{idAtendimento}
LIMIT 09]]>
	</queryString>
	<field name="medicamento_nome" class="java.lang.String"/>
	<field name="medicamento_tipo" class="java.lang.String"/>
	<field name="estoque_dataValidade" class="java.sql.Date"/>
	<field name="atendimento_estoque_atendimentos_idAtendimanto" class="java.lang.Integer"/>
	<field name="atendimento_estoque_estoque_idestoque" class="java.lang.Integer"/>
	<field name="estoque_quantAntiga" class="java.lang.Integer"/>
	<field name="estoque_quant_atual" class="java.lang.Integer"/>
	<field name="lote" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<variable name="conta" class="java.lang.Integer" resetType="Page" calculation="Sum">
		<variableExpression><![CDATA[$F{estoque_quantAntiga}-$F{estoque_quant_atual}]]></variableExpression>
	</variable>
