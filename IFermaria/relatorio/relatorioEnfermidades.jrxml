				<reportElement x="188" y="10" width="367" height="29" uuid="a556e97f-b907-45f9-96bd-57eb84d6dafa"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="18" isBold="true"/>
				</textElement>
				<text><![CDATA[RELATÓRIO DE ENFERMIDADES]]></text>
			</staticText>
			<textField>
				<reportElement x="188" y="39" width="367" height="21" forecolor="#CC0000" uuid="d6ffba2e-f598-4da0-a648-7cac5a694d7f"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="18" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[new java.text.SimpleDateFormat("MMMMM").format($F{atendimento_dataAtendimento})+" DE "+$P{ano}]]></textFieldExpression>
			</textField>
			<image>
