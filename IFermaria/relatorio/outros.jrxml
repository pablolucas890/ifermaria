<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="null" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="df2f0d37-4c89-454b-9bbd-ead457255d95">
	<property name="ireport.zoom" value="1.2100000000000026"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="mes" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="ano" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="outros" class="java.lang.Integer"/>
	<queryString>
		<![CDATA[SELECT
     count(*),
     atendimento.`encaminhamento` AS atendimento_encaminhamento,
     atendimento.`dataAtendimento` AS atendimento_dataAtendimento
FROM
     `atendimento` atendimento
WHERE
     month(dataatendimento) = $P{mes}
     and year(dataatendimento) = $P{ano}
     and encaminhamento NOT IN ("POUSO ALEGRE","CONSULTA MÉDICA LOCAL","POSTO DE SAÚDE EM INCONFIDENTES","PRONTO ATENDIMENTO OURO FINO",""
)
GROUP BY
     encaminhamento
ORDER BY
     count(*) DESC]]>
	</queryString>
	<field name="count(*)" class="java.lang.Long"/>
	<field name="atendimento_encaminhamento" class="java.lang.String"/>
	<field name="atendimento_dataAtendimento" class="java.sql.Date"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="50" splitType="Stretch">
			<textField>
				<reportElement x="0" y="29" width="555" height="21" forecolor="#CC0000" uuid="93a8be9e-5275-4316-9712-c3bd1f7d5e2a"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="18" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[new java.text.SimpleDateFormat("MMMMM").format($F{atendimento_dataAtendimento})+" DE "+$P{ano}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="0" width="555" height="29" uuid="b5acd1c3-1408-49da-9db2-7d1a907d9b55"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Arial" size="18" isBold="true"/>
				</textElement>
				<text><![CDATA[OUTROS ENCAMINHAMENTOS]]></text>
			</staticText>
		</band>
	</title>
	<detail>
