	<parameter name="idAluno" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./relatorio"]]></defaultValueExpression>
	</parameter>
	<parameter name="foto" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
     aluno.`idAluno` AS aluno_idAluno,
     aluno.`nome` AS aluno_nome,
     aluno.`alergias` AS aluno_alergias,
     aluno.`ano` AS aluno_ano,
     aluno.`area` AS aluno_area,
     aluno.`cartaoSUS` AS aluno_cartaoSUS,
     aluno.`cpf` AS aluno_cpf,
     aluno.`dataNasc` AS aluno_dataNasc,
     aluno.`doencas` AS aluno_doencas,
     aluno.`foto` AS aluno_foto,
     aluno.`med_usoContinuo` AS aluno_med_usoContinuo,
     aluno.`procedencia` AS procedencia,
     aluno.`nomeMae` AS aluno_nomeMae,
     aluno.`nomePai` AS aluno_nomePai,
     aluno.`telefoneAluno` AS aluno_telefoneAluno,
     aluno.`telefoneMae` AS aluno_telefoneMae,
     aluno.`telefonePai` AS aluno_telefonePai,
     aluno.`tipo` AS aluno_tipo,
     atendimento.`idAtendimanto` AS atendimento_idAtendimanto,
     atendimento.`conduta` AS atendimento_conduta,
     atendimento.`dataAtendimento` AS atendimento_dataAtendimento,
     atendimento.`encaminhamento` AS atendimento_encaminhamento,
     atendimento.`hora` AS atendimento_hora,
     atendimento.`quantRetirada` AS quantRetirada,
     atendimento.`horaSaida` AS atendimento_horaSaida,
     atendimento.`queixa` AS atendimento_queixa,
     atendente.`nome` AS atendente_nome
FROM
     `aluno` aluno INNER JOIN `atendimento` atendimento ON aluno.`idAluno` = atendimento.`aluno_idAluno`
     INNER JOIN `atendente` atendente ON atendimento.`atendente_idAtendente` = atendente.`idAtendente`
WHERE
     idAluno = $P{idAluno}
ORDER bY
dataAtendimento ASC,
hora ASC]]>
	</queryString>
