<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="null" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="69e37104-d0d1-473a-8832-41ea9186a404">
	<property name="ireport.zoom" value="1.3310000000000353"/>
	<property name="ireport.x" value="93"/>
	<property name="ireport.y" value="514"/>
	<parameter name="id" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["./relatorio"]]></defaultValueExpression>
	</parameter>
	<parameter name="foto" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
     aluno.`nome` AS aluno_nome,
     aluno.`alergias` AS aluno_alergias,
     aluno.`ano` AS aluno_ano,
     aluno.`cartaoSUS` AS aluno_cartaoSUS,
     aluno.`cpf` AS aluno_cpf,
     aluno.`dataNasc` AS aluno_dataNasc,
     aluno.`doencas` AS aluno_doencas,
     aluno.`foto` AS aluno_foto,
     aluno.`med_usoContinuo` AS aluno_med_usoContinuo,
     aluno.`nomeMae` AS aluno_nomeMae,
     aluno.`nomePai` AS aluno_nomePai,
     aluno.`telefoneAluno` AS aluno_telefoneAluno,
     aluno.`telefoneMae` AS aluno_telefoneMae,
     aluno.`telefonePai` AS aluno_telefonePai,
     aluno.`procedencia` AS procedencia,
     aluno.`alojamento` AS alojamento,
     aluno.`tipo` AS aluno_tipo,
     sala.`id` AS sala_id,
     sala.`sala` AS sala_sala,
     curso.`idcurso` AS curso_idcurso,
     curso.`nome` AS curso_nome,
     curso_A.`nome` AS curso_A_nome,
     aluno.`idAluno` AS aluno_idAluno,
     atendimento.`conduta` AS atendimento_conduta,
     atendimento.`dataAtendimento` AS atendimento_dataAtendimento,
     atendimento.`encaminhamento` AS atendimento_encaminhamento,
     atendimento.`hora` AS atendimento_hora,
     atendimento.`horaSaida` AS atendimento_horaSaida,
     atendimento.`queixa` AS atendimento_queixa,
     atendimento.`quantRetirada` AS quantRetirada,
     atendimento.`idAtendimanto` AS atendimento_idAtendimanto,
     atendente.`nome` AS atendente_nome
FROM
     `sala` sala INNER JOIN `aluno` aluno ON sala.`id` = aluno.`sala_id`
     INNER JOIN `curso` curso ON aluno.`curso_idcurso` = curso.`idcurso`
     AND curso.`idcurso` = sala.`curso_idcurso`
     INNER JOIN `curso` curso_A ON sala.`curso_idcurso` = curso_A.`idcurso`
     AND curso_A.`idcurso` = aluno.`curso_idcurso`
     INNER JOIN `atendimento` atendimento ON aluno.`idAluno` = atendimento.`aluno_idAluno`
     INNER JOIN `atendente` atendente ON atendimento.`atendente_idAtendente` = atendente.`idAtendente`
WHERE
     idAluno = $P{id}
ORDER BY
     dataAtendimento ASC,
     hora ASC]]>
	</queryString>
