	<queryString>
		<![CDATA[SELECT
     medicamento.`idmedicamento` AS idmedicamento,
     medicamento.`nome` AS nome,
     medicamento.`unidade` AS unidade,
     medicamento.`tipo` AS tipo,
     medicamento.`catmat` AS catmat,
     medicamento.`quant_Antiga` AS quant_Antiga,
     medicamento.`descricao` AS descricao
FROM
     `medicamento` medicamento
ORDER BY
     nome ASC]]>
	</queryString>
